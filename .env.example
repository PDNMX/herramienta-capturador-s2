# Sistema 2 - PDN Docker Environment Variables
# Copy this file to .env and update values before running docker-compose

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_NAME=directus
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_password_here

# =============================================================================
# DIRECTUS (BACKEND) CONFIGURATION
# =============================================================================
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=your_admin_password_here
DIRECTUS_SECRET=your_secret_key_here

# Backend public URL (as seen from browser)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8055

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Sistema 2 - PDN
NEXT_PUBLIC_APP_VER=2.0
NEXT_PUBLIC_APP_INFO=Servidores Públicos en Contrataciones

# NextAuth configuration
# Generate secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================
EMAIL_FROM=noreply@example.com
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
